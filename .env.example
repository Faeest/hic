# Supabase — HIC CMS
# Copy to .env.local for local dev. On the VPS, provide these via systemd EnvironmentFile.
# NEVER commit real values. Rotate any key that has been shared in plain text.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only. Used ONLY by scripts/seed.ts and admin-only server code.
# Must NOT be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
